# Production builds
/build
dist/
dist
frontend/build/

# Environment & credential files (never commit secrets)
.env
.env.*
*.env
!.env.example
!.env.sample
credentials.json
*.pem
*.key
.credentials
*token.json*
*credentials.json*

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb
*.log

# System files
.DS_Store
Thumbs.db

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Sensitive memory files (test credentials, internal notes)
memory/test_credentials.md

# Mobile development
android-sdk/

# Emergent platform internals (kept locally for the dev environment, not on GitHub)
.emergent/
**/.emergent/
test_reports/
test_result.md
.last_smoke
.gemini/

# OS / IDE artifacts
*.swp
*.swo
*~
